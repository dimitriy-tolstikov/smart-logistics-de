# PostgreSQL (used by docker-compose and local runs).
# Keep these in sync with DATABASE_URL credentials below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deals_bigdata
POSTGRES_PORT=5432

# Full DSN for the app.
# Docker Compose builds this from POSTGRES_* automatically (host=db).
# For local runs use host=localhost and the same user/password/db as POSTGRES_*.
DATABASE_URL=postgresql://postgres:postgres@db:5432/deals_bigdata

# Synthetic data volume (only used on first init inside entrypoint)
N_PRICES=300000

# Business snapshot date (train/test windows are derived from this value)
AS_OF_DATE=2026-10-26

# ETL backfill window [start, end) — must cover all prices you want in core/mart/ml
ETL_START_DATE=2019-01-01
ETL_END_DATE=2027-12-31

ML_RANDOM_SEED=42

# --- Bonus ★ (docker compose --profile bonus) ---

# ClickHouse (mart.route_card / mart.ml_price_predictions sync)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=default
# Set to 1 when running with --profile bonus so app entrypoint also syncs after ML
CLICKHOUSE_SYNC_ENABLED=0

# Apache Airflow UI (http://localhost:8080) — admin/admin
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_META_USER=airflow
AIRFLOW_META_PASSWORD=airflow
AIRFLOW_META_DB=airflow
AIRFLOW_FERNET_KEY=_GsWCOPSw9DYDLNo7sdnE2Vv9VPXAJTTIHAF0uQE1YE=

# Apache Superset UI (http://localhost:8088) — admin/admin
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=ul_local_superset_secret_change_me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset
SUPERSET_DB_NAME=superset
